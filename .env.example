# Copy to .env and fill in locally. Never commit the real .env file.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Only needed for `draft` or `run --draft`.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Optional: use an existing permanent image material ID as the cover.
WECHAT_COVER_MEDIA_ID=

# Optional editorial emphasis, e.g. single-cell omics, GBAI, environmental modeling.
ARTICLE_FOCUS=单细胞组学；通用生物型人工智能（GBAI）；环境建模
